{
  "cli": {
    "version": ">= 16.20.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hark.ryan.ceo",
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "sandbox"
      }
    },
    "development-simulator": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hark.ryan.ceo",
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "sandbox"
      }
    },
    "android-apk": {
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "HARK_BUILD_PLATFORM": "android",
        "EXPO_PUBLIC_API_URL": "https://hark.touchtech.club",
        "ANDROID_PACKAGE": "club.touchtech.hark",
        "EAS_PROJECT_ID": "245beaff-53e2-4a14-a314-8b7e78a3fc40",
        "EXPO_PUBLIC_EAS_PROJECT_ID": "245beaff-53e2-4a14-a314-8b7e78a3fc40",
        "GOOGLE_SERVICES_JSON_CONFIGURED": "true"
      }
    },
    "production": {
      "autoIncrement": true,
      "distribution": "store",
      "ios": {
        "buildConfiguration": "Release"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://hark.ryan.ceo",
        "EXPO_PUBLIC_APNS_ENVIRONMENT": "production"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleTeamId": "9G68SMNHEU",
        "appName": "Hark",
        "ascAppId": "6794121509",
        "bundleIdentifier": "ceo.ryan.hark",
        "language": "en-US",
        "sku": "hark-ios"
      }
    }
  }
}
